generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id              String    @id @default(uuid())
  clerkId         String?   @unique
  dni             String    @unique
  nombre          String
  apellido        String
  email           String    @unique
  telefono        String
  fechaNacimiento DateTime
  contrasena      String?
  rol             Role      @default(PASAJERO)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  reservas        Reserva[]
}

model Vuelo {
  id               String             @id @default(uuid())
  codigoVuelo      String             @unique
  origen           String
  destino          String
  diasOperacion    String[]
  horaSalida       String
  horaLlegada      String
  periodoDesde     String
  periodoHasta     String
  tipoAvion        String
  activo           Boolean            @default(true)
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  capacidadEconomy Int?
  capacidadPrimera Int?
  precioEconomy    Int?
  precioPrimera    Int?
  zonaDestino      String?
  zonaOrigen       String?
  cancelaciones    CancelacionVuelo[]
  reservas         Reserva[]

  @@index([origen, destino])
}

model CancelacionVuelo {
  id        String   @id @default(uuid())
  vueloId   String
  fecha     String
  motivo    String
  createdAt DateTime @default(now())
  vuelo     Vuelo    @relation(fields: [vueloId], references: [id], onDelete: Cascade)

  @@unique([vueloId, fecha])
}

model Reserva {
  id        String            @id @default(uuid())
  userId    String
  vueloId   String
  fecha     String
  clase     String            @default("ECONOMY")
  asientos  Int               @default(1)
  estado    EstadoReserva     @default(CONFIRMADA)
  metodoPago String?
  cuotasPago Int?
  importePagado Int?
  pagadoAt DateTime?
  // true = la canceló el admin al cancelar el vuelo (US-03), no el pasajero; se puede reubicar (US-24)
  canceladaPorVuelo Boolean @default(false)
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  user      User              @relation(fields: [userId], references: [id])
  vuelo     Vuelo             @relation(fields: [vueloId], references: [id], onDelete: Cascade)
  pasajeros PasajeroReserva[]
  reubicaciones Reubicacion[]

  @@index([vueloId, fecha])
  @@index([userId])
}

model PasajeroReserva {
  id          String    @id @default(uuid())
  reservaId   String
  dni         String
  nombre      String
  edad        Int
  telefono    String
  // null = pasaje activo; con fecha = pasaje cancelado por el pasajero (US-13)
  canceladoAt DateTime?
  // campos agregados us20
  checkInCompletado Boolean   @default(false) 
  asiento           String?
  grupoEmbarque     String?
  
  createdAt   DateTime  @default(now())
  reserva     Reserva   @relation(fields: [reservaId], references: [id], onDelete: Cascade)
  ticket      Ticket?

  @@unique([reservaId, dni])
  @@index([dni])
}

model Ticket {
  id                   String            @id @default(uuid())
  pasajeroReservaId    String            @unique
  emitidoAt            DateTime          @default(now())
  validado             Boolean           @default(false)
  validadoAt           DateTime?
  validadoPorId        String?
  emailEstado          EstadoEmailTicket @default(PENDIENTE)
  emailIntentos        Int               @default(0)
  emailUltimoIntentoAt DateTime?
  emailEnviadoAt       DateTime?
  emailError           String?
  emailLockUntil       DateTime?
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt
  pasajeroReserva      PasajeroReserva   @relation(fields: [pasajeroReservaId], references: [id], onDelete: Cascade)

  @@index([emailEstado])
  @@index([emailEstado, emailLockUntil])
  @@index([validado])
}

enum Role {
  ADMINISTRADOR
  PASAJERO
  EMPLEADO_MOSTRADOR
}

enum EstadoReserva {
  PENDIENTE
  CONFIRMADA
  CANCELADA
}

enum EstadoEmailTicket {
  PENDIENTE
  ENVIANDO
  ENVIADO
  ERROR
}

// Historial de reubicaciones manuales hechas por un empleado de mostrador (US-24).
model Reubicacion {
  id              String   @id @default(uuid())
  reservaId       String
  vueloAnteriorId String
  fechaAnterior   String
  vueloNuevoId    String
  fechaNueva      String
  empleadoId      String
  createdAt       DateTime @default(now())
  reserva         Reserva  @relation(fields: [reservaId], references: [id], onDelete: Cascade)

  @@index([reservaId])
}
