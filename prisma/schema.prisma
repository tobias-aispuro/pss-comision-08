generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id              String    @id @default(uuid())
  clerkId         String?   @unique
  dni             String    @unique
  nombre          String
  apellido        String
  email           String    @unique
  telefono        String
  fechaNacimiento DateTime
  contrasena      String?
  rol             Role      @default(PASAJERO)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  reservas        Reserva[]
}

model Vuelo {
  id               String             @id @default(uuid())
  codigoVuelo      String             @unique
  origen           String
  destino          String
  diasOperacion    String[]
  horaSalida       String
  horaLlegada      String
  periodoDesde     String
  periodoHasta     String
  tipoAvion        String
  activo           Boolean            @default(true)
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  capacidadEconomy Int?
  capacidadPrimera Int?
  precioEconomy    Int?
  precioPrimera    Int?
  zonaDestino      String?
  zonaOrigen       String?
  cancelaciones    CancelacionVuelo[]
  reservas         Reserva[]

  @@index([origen, destino])
}

model CancelacionVuelo {
  id        String   @id @default(uuid())
  vueloId   String
  fecha     String
  motivo    String
  createdAt DateTime @default(now())
  vuelo     Vuelo    @relation(fields: [vueloId], references: [id], onDelete: Cascade)

  @@unique([vueloId, fecha])
}

model Reserva {
  id        String        @id @default(uuid())
  userId    String
  vueloId   String
  fecha     String
  clase     String        @default("ECONOMY")
  asientos  Int           @default(1)
  estado    EstadoReserva @default(CONFIRMADA)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  user      User          @relation(fields: [userId], references: [id])
  vuelo     Vuelo         @relation(fields: [vueloId], references: [id], onDelete: Cascade)

  @@index([vueloId, fecha])
  @@index([userId])
}

enum Role {
  ADMINISTRADOR
  PASAJERO
  EMPLEADO_MOSTRADOR
}

enum EstadoReserva {
  CONFIRMADA
  CANCELADA
}
