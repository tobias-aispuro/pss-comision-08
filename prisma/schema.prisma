generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMINISTRADOR
  PASAJERO
  EMPLEADO_MOSTRADOR
}

model User {
  id               String   @id @default(uuid())
  clerkId          String?  @unique 
  dni              String   @unique
  nombre           String
  apellido         String
  email            String   @unique
  telefono         String
  fechaNacimiento  DateTime
  contrasena       String?  
  rol              Role     @default(PASAJERO)
  
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}